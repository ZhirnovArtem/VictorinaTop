<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VictorinaTop.Mobile.Views.CreateGamePage"
             Title="Создание викторины"
             BackgroundColor="#1A1A2E"
             NavigationPage.HasBackButton="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0"
                     Orientation="Horizontal"
                     BackgroundColor="#16213E"
                     Padding="15">
            <Button Text="← Назад"
                    Clicked="OnBackClicked"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    CornerRadius="10"
                    WidthRequest="80"
                    HeightRequest="40"/>
            <Label Text="Создание викторины"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#FFD700"
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"/>
            <Border BackgroundColor="#4A90E2"
                    StrokeThickness="0"
                    Padding="10,5"
                    StrokeShape="RoundRectangle 20">
                <Label x:Name="CounterLabel"
                       Text="0"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </Border>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="20">

                <Label Text="Название викторины"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Entry x:Name="ThemeEntry"
                       Placeholder="Например: История"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <BoxView HeightRequest="2" BackgroundColor="#2D2D44" Margin="0,10"/>

                <Label Text="➕ НОВЫЙ ВОПРОС"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#FFD700"
                       HorizontalOptions="Center"/>

                <Label Text="Текст вопроса"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Entry x:Name="QuestionEntry"
                       Placeholder="Введите вопрос"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Label Text="Сложность"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"/>
                <Picker x:Name="StatusPicker"
                        BackgroundColor="#2D2D44"
                        TextColor="White"
                        Title="Выберите сложность">
                    <Picker.Items>
                        <x:String>Easy</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Hard</x:String>
                    </Picker.Items>
                </Picker>

                <Label Text="✅ Правильный ответ"
                       TextColor="#50C878"
                       FontSize="13"
                       FontAttributes="Bold"/>
                <Entry x:Name="CorrectEntry"
                       Placeholder="Правильный ответ"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Label Text="A"
                       TextColor="#4A90E2"
                       FontSize="13"
                       FontAttributes="Bold"/>
                <Entry x:Name="OptionAEntry"
                       Placeholder="Вариант A"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Label Text="B"
                       TextColor="#4A90E2"
                       FontSize="13"
                       FontAttributes="Bold"/>
                <Entry x:Name="OptionBEntry"
                       Placeholder="Вариант B"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Label Text="C"
                       TextColor="#4A90E2"
                       FontSize="13"
                       FontAttributes="Bold"/>
                <Entry x:Name="OptionCEntry"
                       Placeholder="Вариант C"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Label Text="D"
                       TextColor="#4A90E2"
                       FontSize="13"
                       FontAttributes="Bold"/>
                <Entry x:Name="OptionDEntry"
                       Placeholder="Вариант D"
                       BackgroundColor="#2D2D44"
                       TextColor="White"
                       HeightRequest="50"/>

                <Button Text="➕ Добавить вопрос"
                        Clicked="OnAddQuestion"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        CornerRadius="15"
                        HeightRequest="50"/>

                <Button Text="💾 Сохранить викторину"
                        Clicked="OnSaveQuiz"
                        BackgroundColor="#50C878"
                        TextColor="White"
                        CornerRadius="15"
                        HeightRequest="50"/>

                <Label x:Name="MessageLabel"
                       Text=""
                       TextColor="#FFD700"
                       HorizontalOptions="Center"
                       IsVisible="False"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>