<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VictorinaTop.Mobile.Views.ErrorPage"
             BackgroundColor="#1A1A2E"
             NavigationPage.HasBackButton="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1"
               Text="⚠️"
               FontSize="80"
               TextColor="#FF6B6B"
               HorizontalOptions="Center"/>
        <Label Grid.Row="2"
               Text="Ошибка подключения"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#FFD700"
               HorizontalOptions="Center"
               Margin="0,20,0,10"/>
        <Label x:Name="ErrorMessageLabel"
               Grid.Row="3"
               Text="Не удалось подключиться к серверу.\nПроверьте интернет-соединение и попробуйте снова."
               FontSize="16"
               TextColor="#CCCCCC"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="30,0"/>
        <VerticalStackLayout Grid.Row="4"
                            Spacing="15"
                            Padding="30"
                            VerticalOptions="End"
                            Margin="0,0,0,50">
            <Button Text="🔄 Попробовать снова"
                    x:Name="RetryBtn"
                    Clicked="OnRetryClicked"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="55"/>
            <Button Text="🏠 На главную"
                    x:Name="HomeBtn"
                    Clicked="OnHomeClicked"
                    BackgroundColor="#34495E"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="15"
                    HeightRequest="50"/>
            <Button Text="📝 Попробовать без интернета (офлайн режим)"
                    x:Name="OfflineBtn"
                    Clicked="OnOfflineClicked"
                    BackgroundColor="#9B59B6"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="15"
                    HeightRequest="45"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>